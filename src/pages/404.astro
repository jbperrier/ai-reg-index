---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";
---

<Base
  title="Page not found"
  description="That page is not in the AI Reg. Index."
  path="/404/"
  nav={null}
>
  <div class="sec" style="padding-top:80px;padding-bottom:80px">
    <div class="kicker">404</div>
    <h1 class="h1" style="margin-top:12px">That page is not in the register.</h1>
    <p class="body-text">
      The link may be old, or the entry may have been renamed. Start from the
      <a href={u("/")}>register</a>, or check the
      <a href={u("/amendments/")}>amendments log</a> for recent changes.
    </p>
  </div>
</Base>
