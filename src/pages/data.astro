---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";
import PageHeader from "../components/PageHeader.astro";
import { entries } from "../lib/entries";

const total = entries.length;

const fields = [
  ["section", "Stable index number for the entry (the § in the register)."],
  ["slug", "URL segment for the entry's page."],
  ["jurisdiction", "Government or body that issued the instrument."],
  ["name", "Common name of the law, order, or standard."],
  ["citation", "Official citation for the primary text."],
  ["standing", "Draft, advisory, enacted, in force, or struck down."],
  ["effectiveDate", "Date the instrument takes or took effect, where one exists."],
  ["verifiedAt", "Date an editor last confirmed the entry against its source."],
  ["gloss", "One or two sentences on what the instrument does."],
  ["tags", "Subject labels."],
  ["sourceUrl", "Link to the primary document."],
  ["frameworks", "Cross-framework mappings, e.g. to the NIST AI RMF."],
  ["jsonLd", "schema.org node for the entry (Legislation or CreativeWork)."],
];
---

<Base
  title="Data"
  description="The whole AI Reg. Index as a single JSON file with a schema.org Dataset block. Published to be used and cited. No key, no sign-up."
  path="/data/"
  nav="data"
  metaLabel={`${total} entries · CC BY 4.0`}
>
  <PageHeader
    kicker="Machine-readable register"
    title="Data"
    intro="The register is published to be quoted, cited, and built on. The whole thing is one JSON file. No key, no sign-up, no rate limit."
  />

  <div class="sec">
    <h2 class="h2">The export</h2>
    <p class="body-text">
      One file, all {total} entries, rebuilt whenever an entry is verified.
      Each record carries the fields below. The file itself is a schema.org
      <code>Dataset</code> node with a <code>dateModified</code> stamp, so it
      can be cited as a dataset, not just linked to.
    </p>
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:20px">
      <a href={u("/register.json")} class="btn">register.json</a>
      <a href={u("/sitemap-index.xml")} class="btn-ghost">sitemap.xml</a>
    </div>
  </div>

  <div class="sec">
    <h2 class="h2">Fields</h2>
    <div style="margin-top:18px;max-width:76ch">
      {
        fields.map(([name, desc]) => (
          <div
            class="row-2"
            data-collapse
            style="grid-template-columns:170px 1fr;gap:24px;padding:12px 0"
          >
            <div
              style="font-family:'SFMono-Regular',Menlo,Consolas,monospace;font-size:12.5px;color:oklch(0.85 0.17 130)"
            >
              {name}
            </div>
            <div style="font-size:13.5px;color:oklch(0.75 0.014 265)">
              {desc}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <div class="sec">
    <h2 class="h2">Every page is parseable too</h2>
    <p class="body-text">
      Each register entry page carries the same data inline as schema.org
      JSON-LD in the <code>&lt;head&gt;</code> — <code>Legislation</code> for
      statutes, regulations, and executive orders, <code>CreativeWork</code>
      for standards and advisories. The register itself carries a
      <code>Dataset</code> and an <code>Organization</code> node; entry pages
      add a <code>BreadcrumbList</code>. An answer engine or a scraper can read
      the register without touching the JSON file.
    </p>
    <p class="body-text" style="font-size:13.5px;color:oklch(0.7 0.02 265)">
      With {total} records, filtering by jurisdiction, standing, or tag is a
      one-line operation on whatever consumes the file.
    </p>
  </div>

  <div class="sec">
    <h2 class="h2">Terms</h2>
    <p class="body-text">
      Register text and data are licensed
      <a href="https://creativecommons.org/licenses/by/4.0/"> CC BY 4.0</a> —
      quote it, reformat it, build on it, with attribution:
      <em>AI Reg. Index, airegindex.com</em>, plus the date you retrieved it.
      The primary documents themselves belong to the governments and standards
      bodies that publish them.
    </p>
  </div>
</Base>
