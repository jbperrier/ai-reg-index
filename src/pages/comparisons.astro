---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";
import PageHeader from "../components/PageHeader.astro";
import StandingDot from "../components/StandingDot.astro";
import { crosswalks, crosswalkEntries } from "../lib/entries";
import { shortDate } from "../lib/format";
---

<Base
  title="AI law comparisons and crosswalks"
  description="AI-governance laws that cover the same ground, set side by side — which decisions they reach, who must comply, and what each requires. Every cell links to the primary source."
  path="/comparisons/"
  nav="comparisons"
  metaLabel={`${crosswalks.length} crosswalks`}
>
  <PageHeader
    kicker="Crosswalks"
    title="Comparisons"
    intro="Laws that cover the same ground, set side by side. Every cell links back to the register entry it summarizes, so the comparison stays checkable against the primary source."
  />

  <div class="sec">
    <div class="kicker">All crosswalks</div>
    <div style="margin-top:14px">
      {
        crosswalks.map((cw) => (
          <div
            data-collapse
            style="display:grid;grid-template-columns:1fr auto;gap:24px;align-items:baseline;padding:18px 0;border-top:1px solid oklch(0.24 0.016 265)"
          >
            <div>
              <a
                href={`#${cw.slug}`}
                style="font-size:16px;font-weight:500;color:oklch(0.94 0.008 265)"
              >
                {cw.name}
              </a>
              <div
                style="font-size:12.5px;color:oklch(0.58 0.02 265);margin-top:3px"
              >
                {crosswalkEntries(cw)
                  .map((e) => e.sourceLabel)
                  .join(" · ")}
              </div>
            </div>
            <span
              class="mono"
              style="font-size:11px;letter-spacing:0.06em;text-transform:uppercase;color:oklch(0.85 0.17 130);white-space:nowrap"
            >
              {crosswalkEntries(cw).length} laws
            </span>
          </div>
        ))
      }
    </div>
  </div>

  {
    crosswalks.map((cw) => {
      const cols = crosswalkEntries(cw);
      return (
        <div class="sec" id={cw.slug}>
          <h2 class="h2">{cw.name}</h2>
          <p class="lead">{cw.blurb}</p>

          <div class="cmp-wrap">
            <table class="cmp">
              <thead>
                <tr>
                  <th />
                  {cols.map((e) => (
                    <th>
                      <a href={u(`/sources/${e.slug}/`)}>{e.sourceLabel}</a>
                      <br />
                      <span style="font-weight:400;color:oklch(0.58 0.02 265);font-size:12px">
                        No. {e.section}
                      </span>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th>Citation</th>
                  {cols.map((e) => (
                    <td>{e.citation}</td>
                  ))}
                </tr>
                <tr>
                  <th>Jurisdiction</th>
                  {cols.map((e) => (
                    <td>{e.jurisdiction}</td>
                  ))}
                </tr>
                <tr>
                  <th>Standing</th>
                  {cols.map((e) => (
                    <td>
                      <StandingDot standing={e.standing} />
                    </td>
                  ))}
                </tr>
                <tr>
                  <th>Effective date</th>
                  {cols.map((e) => (
                    <td>{shortDate(e.effectiveDate)}</td>
                  ))}
                </tr>
                {cw.rows.map((row) => (
                  <tr>
                    <th>{row.label}</th>
                    {cols.map((e) => (
                      <td>{row.cells[String(e.section)] ?? "—"}</td>
                    ))}
                  </tr>
                ))}
                <tr>
                  <th>Full entry</th>
                  {cols.map((e) => (
                    <td>
                      <a href={u(`/sources/${e.slug}/`)}>
                        Open entry &rarr;
                      </a>
                    </td>
                  ))}
                </tr>
              </tbody>
            </table>
          </div>

          <p style="font-size:12.5px;color:oklch(0.58 0.02 265);margin-top:16px;max-width:70ch">
            Cells summarize each register entry as verified on its stated date.
            Where a cell would need detail an entry does not yet carry, it points
            to the full entry instead of guessing.
          </p>
        </div>
      );
    })
  }

  <div class="sec">
    <h2 class="h2">How a crosswalk gets built</h2>
    <p class="lead">
      A crosswalk is added when four or more laws in the register cover a shared
      subject and a reader would otherwise have to open every entry to compare
      them. The rows are fixed questions asked of every law. Each answer traces
      to one register entry and inherits that entry’s last-verified date.
    </p>
    <a href={u("/submit/")} class="link-arrow" style="margin-top:18px">
      Suggest an instrument or a crosswalk &rarr;
    </a>
  </div>
</Base>
