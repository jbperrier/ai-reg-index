---
// Google Analytics 4 in Consent Mode with everything denied by default and
// no banner to ever grant it. GA4 then runs in cookieless "ping" mode: it
// reports aggregate traffic (pages, referrers, country) but sets no cookies
// and collects no user-level data, so no consent banner is required.
// Rendered only in production builds — see Base.astro.
---
<script
  is:inline
  async
  src="https://www.googletagmanager.com/gtag/js?id=G-T26D37SH24"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag("consent", "default", {
    ad_storage: "denied",
    ad_user_data: "denied",
    ad_personalization: "denied",
    analytics_storage: "denied",
  });
  gtag("js", new Date());
  gtag("config", "G-T26D37SH24", { anonymize_ip: true });
</script>
